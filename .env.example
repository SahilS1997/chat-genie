# The frontend invokes protected Rayfin Functions on the same origin.
# Configure these settings in the Functions runtime, not VITE_* variables:
# POWERBI_API_BASE_URL=https://api.powerbi.com/v1.0/myorg
# FABRIC_DATA_AGENT_API_BASE_URL=https://<tenant-data-agent-api>

# Public Entra application coordinates used only for delegated browser sign-in.
# Never place a client secret in VITE_* variables.
# VITE_FABRIC_ENTRA_CLIENT_ID=98c11bf8-bd1a-42a3-9385-93d9e706df67
# VITE_FABRIC_ENTRA_TENANT_ID=2cb8edaf-a612-48cc-bcef-80bc609f9c25
# VITE_FABRIC_USER_DATA_FUNCTION_URL=https://<region-host>
# VITE_FABRIC_USER_DATA_FUNCTION_ID=<fabric-user-data-function-id>
# VITE_APP_BASE_PATH=/chat-genie/
